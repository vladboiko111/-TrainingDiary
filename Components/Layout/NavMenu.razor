
@inject IConfiguration Config

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            @ApplicationTitle
        </a>
    </div>
</div>

<input type="checkbox"
       title="Відкрити або закрити меню"
       class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column"
         aria-label="Основна навігація">

        <!-- Основні сторінки -->
        <div class="px-3 pt-3 pb-2">
            <small class="text-white-50">
                ОСНОВНЕ
            </small>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span>
                Головна
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="workouts">
                <span class="bi bi-list-check-nav-menu"
                      aria-hidden="true"></span>
                Мої тренування
            </NavLink>
        </div>

        <!-- Аналітика -->
        <div class="px-3 pt-3 pb-2">
            <small class="text-white-50">
                АНАЛІТИКА
            </small>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="statistics">
                <span class="bi bi-bar-chart-fill-nav-menu"
                      aria-hidden="true"></span>
                Статистика
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="summary">
                <span class="bi bi-table"
                      aria-hidden="true"></span>
                Зведення
            </NavLink>
        </div>

        <!-- Довідники -->
        <div class="px-3 pt-3 pb-2">
            <small class="text-white-50">
                ДОВІДНИКИ
            </small>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sports">
                <span class="bi bi-list-nested-nav-menu"
                      aria-hidden="true"></span>
                Види спорту та вправи
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sportcategories">
                <span class="bi bi-tags"
                      aria-hidden="true"></span>
                Категорії спорту
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="exercises">
                <span class="bi bi-list-check"
                      aria-hidden="true"></span>
                Довідник вправ
            </NavLink>
        </div>

    </nav>
</div>

@code {
    // ЛР №13: назва береться з appsettings.json.
    private string ApplicationTitle =>
        Config["TrainingDiary:Title"] ?? "Щоденник тренувань";
}
