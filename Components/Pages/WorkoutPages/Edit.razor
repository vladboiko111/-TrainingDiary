
@page "/workouts/edit"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.Sqlite
@using TrainingDiary.Models

@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редагування тренування — Щоденник тренувань</PageTitle>

<h1>Редагування тренування</h1>

<p class="text-muted">
    Змініть необхідні дані та збережіть тренування.
</p>

<hr />

@if (existingWorkout is null)
{
    <div class="alert alert-warning">
        Тренування не знайдено.
    </div>
}
else
{
    <div class="row">
        <div class="col-12 col-md-7 col-lg-6">

            <form method="post"
                  @onsubmit="UpdateWorkout"
                  @formname="edit-workout-lab7">

                <AntiforgeryToken />

                <input type="hidden"
                       name="SubmissionMarker"
                       value="yes" />

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger" role="alert">
                        @error
                    </div>
                }

                <div class="mb-3">
                    <label for="category" class="form-label">
                        Вид спорту
                    </label>

                    <select id="category"
                            name="SelectedCategoryId"
                            class="form-select"
                            required>

                        <option value=""
                                selected="@(!SelectedCategoryId.HasValue)">
                            -- Оберіть вид спорту --
                        </option>

                        @foreach (var category in sportCategories)
                        {
                            <option value="@category.Id"
                                    selected="@(SelectedCategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="exercise" class="form-label">
                        Назва вправи
                    </label>

                    <select id="exercise"
                            name="SelectedExerciseId"
                            class="form-select"
                            required>

                        <option value=""
                                selected="@(!SelectedExerciseId.HasValue)">
                            -- Оберіть вправу --
                        </option>

                        @foreach (var exercise in exercises)
                        {
                            <option value="@exercise.Id"
                                    selected="@(SelectedExerciseId == exercise.Id)">
                                @exercise.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="type" class="form-label">
                        Категорія тренування
                    </label>

                    <select id="type"
                            name="SelectedType"
                            class="form-select"
                            required>

                        @foreach (var type in Enum.GetValues<WorkoutType>())
                        {
                            <option value="@type"
                                    selected="@(SelectedType == type)">
                                @GetTypeName(type)
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="duration" class="form-label">
                        Тривалість (хв)
                    </label>

                    <input type="number"
                           id="duration"
                           name="DurationMinutes"
                           value="@DurationMinutes"
                           min="1"
                           max="600"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label for="distance" class="form-label">
                        Дистанція (км)
                    </label>

                    <input type="number"
                           id="distance"
                           name="DistanceText"
                           value="@DistanceText"
                           min="0"
                           max="1000"
                           step="any"
                           class="form-control" />

                    <div class="form-text">
                        Для кардіотренування дистанція обов'язкова.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="performedon" class="form-label">
                        Дата тренування
                    </label>

                    <input type="date"
                           id="performedon"
                           name="PerformedOn"
                           value="@(PerformedOn?.ToString("yyyy-MM-dd"))"
                           class="form-control"
                           required />
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">
                        Зберегти зміни
                    </button>

                    <a href="/workouts"
                       class="btn btn-outline-secondary">
                        Скасувати
                    </a>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private Workout? existingWorkout;

    private List<SportCategory> sportCategories = new();
    private List<Exercise> exercises = new();

    [SupplyParameterFromForm(FormName = "edit-workout-lab7")]
    private string? SubmissionMarker { get; set; }

    [SupplyParameterFromForm(FormName = "edit-workout-lab7")]
    private int? SelectedCategoryId { get; set; }

    [SupplyParameterFromForm(FormName = "edit-workout-lab7")]
    private int? SelectedExerciseId { get; set; }

    [SupplyParameterFromForm(FormName = "edit-workout-lab7")]
    private WorkoutType? SelectedType { get; set; }

    [SupplyParameterFromForm(FormName = "edit-workout-lab7")]
    private int? DurationMinutes { get; set; }

    [SupplyParameterFromForm(FormName = "edit-workout-lab7")]
    private string? DistanceText { get; set; }

    [SupplyParameterFromForm(FormName = "edit-workout-lab7")]
    private DateTime? PerformedOn { get; set; }

    private string? error;

    private static string GetTypeName(WorkoutType type)
    {
        return type switch
        {
            WorkoutType.Strength => "Силові",
            WorkoutType.Cardio => "Кардіо",
            WorkoutType.Recovery => "Відновлення",
            _ => type.ToString()
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        sportCategories = await context.SportCategories
            .AsNoTracking()
            .OrderBy(c => c.Name)
            .ToListAsync();

        exercises = await context.Exercises
            .AsNoTracking()
            .OrderBy(e => e.Name)
            .ToListAsync();

        existingWorkout = await context.Workouts
            .AsNoTracking()
            .FirstOrDefaultAsync(w => w.Id == Id);

        if (existingWorkout is null)
        {
            NavigationManager.NotFound();
            return;
        }

        if (SubmissionMarker != "yes")
        {
            SelectedCategoryId = existingWorkout.SportCategoryId;
            SelectedExerciseId = existingWorkout.ExerciseId;

            if (!SelectedCategoryId.HasValue)
            {
                SelectedCategoryId = sportCategories
                    .FirstOrDefault(c =>
                        c.Name == existingWorkout.SportType)?.Id;
            }

            if (!SelectedExerciseId.HasValue)
            {
                SelectedExerciseId = exercises
                    .FirstOrDefault(e =>
                        e.Name == existingWorkout.ExerciseName)?.Id;
            }

            SelectedType = existingWorkout.Type;
            DurationMinutes = existingWorkout.DurationMinutes;

            DistanceText = existingWorkout.Distance?
                .ToString(CultureInfo.InvariantCulture);

            PerformedOn = existingWorkout.PerformedOn;
        }
    }

    private async Task UpdateWorkout()
    {
        error = null;

        if (!SelectedCategoryId.HasValue ||
            !SelectedExerciseId.HasValue)
        {
            error = "Оберіть вид спорту та вправу.";
            return;
        }

        if (!SelectedType.HasValue ||
            !Enum.IsDefined(typeof(WorkoutType), SelectedType.Value))
        {
            error = "Оберіть правильну категорію тренування.";
            return;
        }

        if (!DurationMinutes.HasValue)
        {
            error = "Вкажіть тривалість тренування.";
            return;
        }

        if (!PerformedOn.HasValue)
        {
            error = "Вкажіть дату тренування.";
            return;
        }

        decimal? distance = null;

        if (!string.IsNullOrWhiteSpace(DistanceText))
        {
            var normalizedDistance = DistanceText.Trim()
                .Replace(',', '.');

            if (decimal.TryParse(
                normalizedDistance,
                NumberStyles.AllowDecimalPoint |
                NumberStyles.AllowLeadingSign,
                CultureInfo.InvariantCulture,
                out var parsedDistance))
            {
                distance = parsedDistance;
            }
            else
            {
                error = "Вкажіть коректну дистанцію.";
                return;
            }
        }

        await using var context =
            await DbFactory.CreateDbContextAsync();

        var category = await context.SportCategories
            .AsNoTracking()
            .FirstOrDefaultAsync(c =>
                c.Id == SelectedCategoryId.Value);

        var exercise = await context.Exercises
            .AsNoTracking()
            .FirstOrDefaultAsync(e =>
                e.Id == SelectedExerciseId.Value);

        if (category is null || exercise is null)
        {
            error = "Обраний вид спорту або вправу не знайдено.";
            return;
        }

        var workout = new Workout
        {
            Id = Id,
            SportCategoryId = category.Id,
            ExerciseId = exercise.Id,

            SportType = category.Name,
            ExerciseName = exercise.Name,

            ExerciseNameSearch =
                exercise.Name.Trim().ToLowerInvariant(),

            Type = SelectedType.Value,
            DurationMinutes = DurationMinutes.Value,
            Distance = distance,
            PerformedOn = PerformedOn.Value
        };

        var validationResults = new List<ValidationResult>();

        bool isValid = Validator.TryValidateObject(
            workout,
            new ValidationContext(workout),
            validationResults,
            validateAllProperties: true
        );

        if (!isValid)
        {
            error = string.Join(" ",
                validationResults.Select(r => r.ErrorMessage));
            return;
        }

        var record = await context.Workouts
            .FirstOrDefaultAsync(w => w.Id == Id);

        if (record is null)
        {
            error = "Тренування не знайдено. Можливо, його видалено.";
            return;
        }

        record.SportCategoryId = workout.SportCategoryId;
        record.ExerciseId = workout.ExerciseId;

        record.SportType = workout.SportType;
        record.ExerciseName = workout.ExerciseName;
        record.ExerciseNameSearch = workout.ExerciseNameSearch;

        record.Type = workout.Type;
        record.DurationMinutes = workout.DurationMinutes;
        record.Distance = workout.Distance;
        record.PerformedOn = workout.PerformedOn;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            error = "Запис було змінено або видалено. Оновіть сторінку.";
            return;
        }
        catch (DbUpdateException ex)
        {
            if (ex.GetBaseException() is SqliteException sqliteEx &&
                sqliteEx.SqliteExtendedErrorCode == 2067)
            {
                error = "Тренування з такою назвою та датою вже існує.";
            }
            else
            {
                error = "Не вдалося зберегти зміни. Спробуйте ще раз.";
            }

            return;
        }

        // Повідомлення про успішне редагування.
        NavigationManager.NavigateTo("/workouts?saved=true");
    }
}
