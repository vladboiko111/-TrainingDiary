
@page "/workouts/edit"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.Sqlite
@using TrainingDiary.Models
@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Редагування тренування</PageTitle>

<h1>Редагувати тренування</h1>
<h2>Зміна інформації про тренування</h2>
<hr />

@if (Workout is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">

            <EditForm method="post"
                      Model="Workout"
                      OnValidSubmit="UpdateWorkout"
                      FormName="edit">

                <DataAnnotationsValidator />

                <ValidationSummary class="text-danger"
                                   role="alert" />

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger" role="alert">
                        @error
                    </div>
                }

                <input type="hidden"
                       name="Workout.Id"
                       value="@Workout.Id" />

                <div class="mb-3">
                    <label for="sporttype" class="form-label">
                        Вид спорту:
                    </label>

                    <InputText id="sporttype"
                               @bind-Value="Workout.SportType"
                               class="form-control" />

                    <ValidationMessage
                        For="() => Workout.SportType"
                        class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="exercisename" class="form-label">
                        Назва вправи:
                    </label>

                    <InputText id="exercisename"
                               @bind-Value="Workout.ExerciseName"
                               class="form-control" />

                    <ValidationMessage
                        For="() => Workout.ExerciseName"
                        class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="type" class="form-label">
                        Категорія тренування:
                    </label>

                    <InputSelect TValue="WorkoutType"
                                 id="type"
                                 @bind-Value="Workout.Type"
                                 class="form-control">

                        @foreach (var type in Enum.GetValues<WorkoutType>())
                        {
                            <option value="@type">@type</option>
                        }

                    </InputSelect>

                    <ValidationMessage
                        For="() => Workout.Type"
                        class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="durationminutes" class="form-label">
                        Тривалість (хвилини):
                    </label>

                    <InputNumber id="durationminutes"
                                 @bind-Value="Workout.DurationMinutes"
                                 class="form-control" />

                    <ValidationMessage
                        For="() => Workout.DurationMinutes"
                        class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="distance" class="form-label">
                        Дистанція (км):
                    </label>

                    <InputNumber id="distance"
                                 @bind-Value="Workout.Distance"
                                 class="form-control" />

                    <ValidationMessage
                        For="() => Workout.Distance"
                        class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="performedon" class="form-label">
                        Дата тренування:
                    </label>

                    <InputDate id="performedon"
                               @bind-Value="Workout.PerformedOn"
                               class="form-control" />

                    <ValidationMessage
                        For="() => Workout.PerformedOn"
                        class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Зберегти зміни
                </button>

            </EditForm>
        </div>
    </div>
}

<div class="mt-3">
    <a href="/workouts">Назад до списку</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Workout? Workout { get; set; }

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        Workout ??= await context.Workouts
            .FirstOrDefaultAsync(w => w.Id == Id);

        if (Workout is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateWorkout()
    {
        error = null;

        if (Workout is null)
        {
            return;
        }

        using var context = DbFactory.CreateDbContext();

        var existingWorkout = await context.Workouts
            .FirstOrDefaultAsync(w => w.Id == Id);

        if (existingWorkout is null)
        {
            error = "Тренування не знайдено. Можливо, його вже видалено.";
            return;
        }

        // Оновлюємо лише дозволені властивості.
        existingWorkout.SportType = Workout.SportType;
        existingWorkout.ExerciseName = Workout.ExerciseName;
        existingWorkout.Type = Workout.Type;
        existingWorkout.DurationMinutes = Workout.DurationMinutes;
        existingWorkout.Distance = Workout.Distance;
        existingWorkout.PerformedOn = Workout.PerformedOn;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            error = "Не вдалося зберегти зміни. Запис було змінено або видалено. Оновіть сторінку.";
            return;
        }
        catch (DbUpdateException ex)
        {
            if (ex.GetBaseException() is SqliteException sqliteEx &&
                sqliteEx.SqliteExtendedErrorCode == 2067)
            {
                error = "Тренування з такою назвою та датою вже існує.";
            }
            else
            {
                error = "Не вдалося зберегти зміни. Спробуйте ще раз.";
            }

            return;
        }

        NavigationManager.NavigateTo("/workouts");
    }
}
