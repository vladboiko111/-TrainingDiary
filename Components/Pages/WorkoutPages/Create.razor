
@page "/workouts/create"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.Sqlite
@using TrainingDiary.Models
@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Створення тренування</PageTitle>

<h1>Додати тренування</h1>
<h2>Нове тренування</h2>
<hr />

<div class="row">
    <div class="col-md-6">

        <EditForm method="post"
                  Model="Workout"
                  OnValidSubmit="AddWorkout"
                  FormName="create">

            <DataAnnotationsValidator />

            <ValidationSummary class="text-danger"
                               role="alert" />

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger" role="alert">
                    @error
                </div>
            }

            <div class="mb-3">
                <label for="sporttype" class="form-label">
                    Вид спорту:
                </label>

                <InputText id="sporttype"
                           @bind-Value="Workout.SportType"
                           class="form-control" />

                <ValidationMessage
                    For="() => Workout.SportType"
                    class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="exercisename" class="form-label">
                    Назва вправи:
                </label>

                <InputText id="exercisename"
                           @bind-Value="Workout.ExerciseName"
                           class="form-control" />

                <ValidationMessage
                    For="() => Workout.ExerciseName"
                    class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="type" class="form-label">
                    Категорія тренування:
                </label>

                <InputSelect TValue="WorkoutType"
                             id="type"
                             @bind-Value="Workout.Type"
                             class="form-control">

                    @foreach (var type in Enum.GetValues<WorkoutType>())
                    {
                        <option value="@type">@type</option>
                    }

                </InputSelect>
            </div>

            <div class="mb-3">
                <label for="durationminutes" class="form-label">
                    Тривалість (хвилини):
                </label>

                <InputNumber id="durationminutes"
                             @bind-Value="Workout.DurationMinutes"
                             class="form-control" />

                <ValidationMessage
                    For="() => Workout.DurationMinutes"
                    class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="distance" class="form-label">
                    Дистанція (км):
                </label>

                <InputNumber id="distance"
                             @bind-Value="Workout.Distance"
                             class="form-control" />

                <ValidationMessage
                    For="() => Workout.Distance"
                    class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="performedon" class="form-label">
                    Дата тренування:
                </label>

                <InputDate id="performedon"
                           @bind-Value="Workout.PerformedOn"
                           class="form-control" />

                <ValidationMessage
                    For="() => Workout.PerformedOn"
                    class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">
                Зберегти тренування
            </button>

        </EditForm>
    </div>
</div>

<div class="mt-3">
    <a href="/workouts">Назад до списку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Workout Workout { get; set; } = default!;

    private string? error;

    protected override void OnInitialized()
    {
        Workout ??= new();
    }

    private async Task AddWorkout()
    {
        error = null;

        using var context = DbFactory.CreateDbContext();

        try
        {
            context.Workouts.Add(Workout);

            await context.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
        {
            if (ex.GetBaseException() is SqliteException sqliteEx &&
                sqliteEx.SqliteExtendedErrorCode == 2067)
            {
                error = "Тренування з такою назвою та датою вже існує.";
            }
            else
            {
                error = "Не вдалося зберегти тренування. Спробуйте ще раз.";
            }

            return;
        }

        NavigationManager.NavigateTo("/workouts");
    }
}
