
@page "/workouts/create"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.Sqlite
@using TrainingDiary.Models

@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager
@inject ILogger<Create> Logger

<PageTitle>Додати тренування — Щоденник тренувань</PageTitle>

<h1>Додати тренування</h1>

<p class="text-muted">
    Заповніть інформацію про нове тренування.
</p>

<hr />

<div class="row">
    <div class="col-12 col-md-7 col-lg-6">

        <form method="post"
              @onsubmit="AddWorkout"
              @formname="create-workout-lab7">

            <AntiforgeryToken />

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger" role="alert">
                    @error
                </div>
            }

            <div class="mb-3">
                <label for="category" class="form-label">
                    Вид спорту
                </label>

                <select id="category"
                        name="SelectedCategoryId"
                        class="form-select"
                        required>

                    <option value="">
                        -- Оберіть вид спорту --
                    </option>

                    @foreach (var category in sportCategories)
                    {
                        <option value="@category.Id"
                                selected="@(SelectedCategoryId == category.Id)">
                            @category.Name
                        </option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="exercise" class="form-label">
                    Назва вправи
                </label>

                <select id="exercise"
                        name="SelectedExerciseId"
                        class="form-select"
                        required>

                    <option value="">
                        -- Оберіть вправу --
                    </option>

                    @foreach (var exercise in exercises)
                    {
                        <option value="@exercise.Id"
                                selected="@(SelectedExerciseId == exercise.Id)">
                            @exercise.Name
                        </option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="type" class="form-label">
                    Категорія тренування
                </label>

                <select id="type"
                        name="SelectedType"
                        class="form-select"
                        required>

                    @foreach (var type in Enum.GetValues<WorkoutType>())
                    {
                        <option value="@type"
                                selected="@(SelectedType == type)">
                            @GetTypeName(type)
                        </option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="duration" class="form-label">
                    Тривалість (хв)
                </label>

                <input type="number"
                       id="duration"
                       name="DurationMinutes"
                       value="@DurationMinutes"
                       min="1"
                       max="600"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label for="distance" class="form-label">
                    Дистанція (км)
                </label>

                <input type="number"
                       id="distance"
                       name="DistanceText"
                       value="@DistanceText"
                       min="0"
                       max="1000"
                       step="any"
                       class="form-control" />

                <div class="form-text">
                    Для кардіотренування дистанція обов'язкова.
                </div>
            </div>

            <div class="mb-3">
                <label for="performedon" class="form-label">
                    Дата тренування
                </label>

                <input type="date"
                       id="performedon"
                       name="PerformedOn"
                       value="@((PerformedOn ?? DateTime.Today).ToString("yyyy-MM-dd"))"
                       class="form-control"
                       required />
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit"
                        class="btn btn-primary"
                        disabled="@(sportCategories.Count == 0 || exercises.Count == 0)">
                    Зберегти тренування
                </button>

                <a href="/workouts"
                   class="btn btn-outline-secondary">
                    Скасувати
                </a>
            </div>

        </form>
    </div>
</div>

@code {
    private List<SportCategory> sportCategories = new();
    private List<Exercise> exercises = new();

    [SupplyParameterFromForm(FormName = "create-workout-lab7")]
    private int? SelectedCategoryId { get; set; }

    [SupplyParameterFromForm(FormName = "create-workout-lab7")]
    private int? SelectedExerciseId { get; set; }

    [SupplyParameterFromForm(FormName = "create-workout-lab7")]
    private WorkoutType SelectedType { get; set; }

    [SupplyParameterFromForm(FormName = "create-workout-lab7")]
    private int DurationMinutes { get; set; }

    [SupplyParameterFromForm(FormName = "create-workout-lab7")]
    private string? DistanceText { get; set; }

    [SupplyParameterFromForm(FormName = "create-workout-lab7")]
    private DateTime? PerformedOn { get; set; }

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        sportCategories = await context.SportCategories
            .AsNoTracking()
            .OrderBy(c => c.Name)
            .ToListAsync();

        exercises = await context.Exercises
            .AsNoTracking()
            .OrderBy(e => e.Name)
            .ToListAsync();
    }

    private static string GetTypeName(WorkoutType type)
    {
        return type switch
        {
            WorkoutType.Strength => "Силові",
            WorkoutType.Cardio => "Кардіо",
            WorkoutType.Recovery => "Відновлення",
            _ => type.ToString()
        };
    }

    private async Task AddWorkout()
    {
        error = null;

        if (!SelectedCategoryId.HasValue ||
            !SelectedExerciseId.HasValue)
        {
            error = "Оберіть вид спорту та вправу.";
            return;
        }

        if (!Enum.IsDefined(typeof(WorkoutType), SelectedType))
        {
            error = "Оберіть правильну категорію тренування.";
            return;
        }

        if (!PerformedOn.HasValue)
        {
            error = "Вкажіть дату тренування.";
            return;
        }

        decimal? distance = null;

        if (!string.IsNullOrWhiteSpace(DistanceText))
        {
            var normalizedDistance = DistanceText.Trim()
                .Replace(',', '.');

            if (decimal.TryParse(
                normalizedDistance,
                NumberStyles.AllowDecimalPoint |
                NumberStyles.AllowLeadingSign,
                CultureInfo.InvariantCulture,
                out var parsedDistance))
            {
                distance = parsedDistance;
            }
            else
            {
                error = "Вкажіть коректну дистанцію.";
                return;
            }
        }

        await using var context =
            await DbFactory.CreateDbContextAsync();

        var category = await context.SportCategories
            .AsNoTracking()
            .FirstOrDefaultAsync(c =>
                c.Id == SelectedCategoryId.Value);

        var exercise = await context.Exercises
            .AsNoTracking()
            .FirstOrDefaultAsync(e =>
                e.Id == SelectedExerciseId.Value);

        if (category is null || exercise is null)
        {
            error = "Обраний вид спорту або вправу не знайдено.";
            return;
        }

        var workout = new Workout
        {
            SportCategoryId = category.Id,
            ExerciseId = exercise.Id,

            SportType = category.Name,
            ExerciseName = exercise.Name,

            ExerciseNameSearch =
                exercise.Name.Trim().ToLowerInvariant(),

            Type = SelectedType,
            DurationMinutes = DurationMinutes,
            Distance = distance,
            PerformedOn = PerformedOn.Value
        };

        var validationResults = new List<ValidationResult>();

        bool isValid = Validator.TryValidateObject(
            workout,
            new ValidationContext(workout),
            validationResults,
            validateAllProperties: true
        );

        if (!isValid)
        {
            error = string.Join(" ",
                validationResults.Select(r => r.ErrorMessage));
            return;
        }

        try
        {
            context.Workouts.Add(workout);
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
        {
            if (ex.GetBaseException() is SqliteException sqliteEx &&
                sqliteEx.SqliteExtendedErrorCode == 2067)
            {
                error = "Тренування з такою назвою та датою вже існує.";

                Logger.LogWarning(
                    "Не вдалося створити тренування: дубль запису.");
            }
            else
            {
                error = "Не вдалося зберегти тренування. Спробуйте ще раз.";

                Logger.LogError(
                    ex,
                    "Помилка створення тренування.");
            }

            return;
        }

        // ЛР №13: журналювання після успішного збереження.
        Logger.LogInformation(
            "Створено тренування з ID {WorkoutId}",
            workout.Id);

        NavigationManager.NavigateTo("/workouts?saved=true");
    }
}
