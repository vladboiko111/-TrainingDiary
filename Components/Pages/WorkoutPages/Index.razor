
@page "/workouts"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using TrainingDiary.Models
@using TrainingDiary.Data

@inject IDbContextFactory<TrainingDiaryContext> DbFactory

<PageTitle>Мої тренування — Щоденник тренувань</PageTitle>

<h1>Мої тренування</h1>

<p class="text-muted">
    Переглядайте, шукайте та впорядковуйте свої тренування.
</p>

@if (Saved == true)
{
    <div class="alert alert-success" role="status">
        <strong>Успішно!</strong> Тренування збережено.

        <a href="/workouts" class="alert-link ms-2">
            Закрити
        </a>
    </div>
}

@if (Deleted == true)
{
    <div class="alert alert-success" role="status">
        <strong>Успішно!</strong> Тренування видалено.

        <a href="/workouts" class="alert-link ms-2">
            Закрити
        </a>
    </div>
}

<p>
    <a href="/workouts/create" class="btn btn-primary">
        + Додати тренування
    </a>
</p>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5 card-title mb-3">
            Пошук і фільтрація тренувань
        </h2>

        <form method="get" action="/workouts">
            <div class="row g-3">

                <div class="col-12 col-md-6">
                    <label for="search" class="form-label">
                        Пошук за назвою вправи
                    </label>

                    <input type="search"
                           id="search"
                           name="search"
                           value="@Search"
                           class="form-control"
                           placeholder="Наприклад: жим або біг" />
                </div>

                <div class="col-12 col-md-3">
                    <label for="type" class="form-label">
                        Тип тренування
                    </label>

                    <select id="type" name="type"
                            class="form-select">

                        <option value=""
                                selected="@(string.IsNullOrEmpty(TypeFilter))">
                            Усі типи
                        </option>

                        @foreach (var type in Enum.GetValues<WorkoutType>())
                        {
                            <option value="@type"
                                    selected="@(TypeFilter == type.ToString())">
                                @GetTypeName(type)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label for="sport" class="form-label">
                        Вид спорту
                    </label>

                    <select id="sport" name="sport"
                            class="form-select">

                        <option value=""
                                selected="@(!SportFilter.HasValue)">
                            Усі види спорту
                        </option>

                        @foreach (var category in sportCategories)
                        {
                            <option value="@category.Id"
                                    selected="@(SportFilter == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label for="sort" class="form-label">
                        Сортування
                    </label>

                    <select id="sort" name="sort"
                            class="form-select">

                        <option value="id"
                                selected="@(Sort == "id" || string.IsNullOrEmpty(Sort))">
                            За порядком додавання
                        </option>

                        <option value="date_desc"
                                selected="@(Sort == "date_desc")">
                            Дата: від нових до старих
                        </option>

                        <option value="date_asc"
                                selected="@(Sort == "date_asc")">
                            Дата: від старих до нових
                        </option>

                        <option value="duration_desc"
                                selected="@(Sort == "duration_desc")">
                            Тривалість: від більшої
                        </option>

                        <option value="duration_asc"
                                selected="@(Sort == "duration_asc")">
                            Тривалість: від меншої
                        </option>

                        <option value="name"
                                selected="@(Sort == "name")">
                            Назва вправи: А–Я
                        </option>
                    </select>
                </div>

            </div>

            <div class="mt-3 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    Знайти
                </button>

                <a href="/workouts"
                   class="btn btn-outline-secondary">
                    Скинути фільтри
                </a>
            </div>
        </form>
    </div>
</div>

<p>
    <strong>Знайдено тренувань: @TotalCount</strong>
</p>

@if (displayedWorkouts.Count == 0)
{
    @if (HasActiveFilters)
    {
        <div class="alert alert-info" role="status">
            <h2 class="h5">
                За вашим запитом нічого не знайдено
            </h2>

            <p>
                Спробуйте змінити запит або параметри фільтрації.
            </p>

            <a href="/workouts" class="btn btn-outline-primary">
                Показати всі тренування
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="status">
            <h2 class="h5">Тренувань поки немає</h2>

            <p>
                Створіть перше тренування, щоб розпочати
                ведення щоденника.
            </p>

            <a href="/workouts/create" class="btn btn-primary">
                Додати перше тренування
            </a>
        </div>
    }
}
else
{
    <div class="table-responsive"
         role="region"
         aria-label="Таблиця тренувань"
         tabindex="0">

        <QuickGrid Class="table table-striped table-hover"
                   Items="@displayedWorkouts.AsQueryable()">

            <TemplateColumn Title="Вид спорту" Context="workout">
                @(workout.SportCategory?.Name ?? workout.SportType)
            </TemplateColumn>

            <TemplateColumn Title="Назва вправи" Context="workout">
                @(workout.Exercise?.Name ?? workout.ExerciseName)
            </TemplateColumn>

            <TemplateColumn Title="Категорія" Context="workout">
                @GetTypeName(workout.Type)
            </TemplateColumn>

            <PropertyColumn Property="workout => workout.DurationMinutes"
                            Title="Тривалість (хв)" />

            <PropertyColumn Property="workout => workout.Distance"
                            Title="Дистанція (км)" />

            <PropertyColumn Property="workout => workout.PerformedOn"
                            Title="Дата"
                            Format="dd.MM.yyyy" />

            <TemplateColumn Title="Дії" Context="workout">
                <div class="d-flex flex-wrap gap-2">

                    <a href="@($"/workouts/edit?id={workout.Id}")"
                       class="btn btn-sm btn-outline-primary">
                        Редагувати
                    </a>

                    <a href="@($"/workouts/details?id={workout.Id}")"
                       class="btn btn-sm btn-outline-secondary">
                        Деталі
                    </a>

                    <a href="@($"/workouts/delete?id={workout.Id}")"
                       class="btn btn-sm btn-outline-danger">
                        Видалити
                    </a>
                </div>
            </TemplateColumn>

        </QuickGrid>
    </div>
}

@if (TotalCount > 0)
{
    <nav class="mt-3"
         aria-label="Навігація сторінками тренувань">

        <div class="d-flex flex-wrap align-items-center gap-3">

            @if (CurrentPage > 1)
            {
                <a class="btn btn-outline-primary"
                   href="@BuildPageUrl(CurrentPage - 1)">
                    Назад
                </a>
            }

            <span>
                Сторінка @CurrentPage з @TotalPages
            </span>

            @if (CurrentPage < TotalPages)
            {
                <a class="btn btn-outline-primary"
                   href="@BuildPageUrl(CurrentPage + 1)">
                    Далі
                </a>
            }

        </div>
    </nav>
}

@code {
    [SupplyParameterFromQuery(Name = "search")]
    private string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    private string? TypeFilter { get; set; }

    [SupplyParameterFromQuery(Name = "sport")]
    private int? SportFilter { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    private string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    private bool? Saved { get; set; }

    // ЛР №10: повідомлення після видалення.
    [SupplyParameterFromQuery(Name = "deleted")]
    private bool? Deleted { get; set; }

    private const int PageSize = 5;

    private List<Workout> displayedWorkouts = new();
    private List<SportCategory> sportCategories = new();

    private int TotalCount;
    private int CurrentPage = 1;
    private int TotalPages = 1;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(Search) ||
        !string.IsNullOrWhiteSpace(TypeFilter) ||
        SportFilter.HasValue;

    private static string GetTypeName(WorkoutType type)
    {
        return type switch
        {
            WorkoutType.Strength => "Силові",
            WorkoutType.Cardio => "Кардіо",
            WorkoutType.Recovery => "Відновлення",
            _ => type.ToString()
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        sportCategories = await context.SportCategories
            .AsNoTracking()
            .OrderBy(c => c.Name)
            .ToListAsync();

        IQueryable<Workout> query = context.Workouts
            .AsNoTracking()
            .Include(w => w.SportCategory)
            .Include(w => w.Exercise);

        if (!string.IsNullOrWhiteSpace(Search))
        {
            string searchText = Search.Trim().ToLowerInvariant();

            query = query.Where(w =>
                w.ExerciseNameSearch.Contains(searchText));
        }

        if (!string.IsNullOrWhiteSpace(TypeFilter) &&
            Enum.TryParse<WorkoutType>(
                TypeFilter,
                true,
                out var selectedType) &&
            Enum.IsDefined(typeof(WorkoutType), selectedType))
        {
            query = query.Where(w =>
                w.Type == selectedType);
        }

        if (SportFilter.HasValue)
        {
            int categoryId = SportFilter.Value;

            query = query.Where(w =>
                w.SportCategoryId == categoryId);
        }

        query = Sort switch
        {
            "date_desc" => query
                .OrderByDescending(w => w.PerformedOn)
                .ThenBy(w => w.Id),

            "date_asc" => query
                .OrderBy(w => w.PerformedOn)
                .ThenBy(w => w.Id),

            "duration_desc" => query
                .OrderByDescending(w => w.DurationMinutes)
                .ThenBy(w => w.Id),

            "duration_asc" => query
                .OrderBy(w => w.DurationMinutes)
                .ThenBy(w => w.Id),

            "name" => query
                .OrderBy(w => w.ExerciseNameSearch)
                .ThenBy(w => w.Id),

            _ => query.OrderBy(w => w.Id)
        };

        TotalCount = await query.CountAsync();

        TotalPages = Math.Max(
            1,
            (TotalCount + PageSize - 1) / PageSize
        );

        CurrentPage = Math.Clamp(
            Page ?? 1,
            1,
            TotalPages
        );

        displayedWorkouts = await query
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private string BuildPageUrl(int pageNumber)
    {
        var parameters = new List<string>
        {
            $"page={pageNumber}"
        };

        if (!string.IsNullOrWhiteSpace(Search))
        {
            parameters.Add(
                $"search={Uri.EscapeDataString(Search)}");
        }

        if (!string.IsNullOrWhiteSpace(TypeFilter))
        {
            parameters.Add(
                $"type={Uri.EscapeDataString(TypeFilter)}");
        }

        if (SportFilter.HasValue)
        {
            parameters.Add(
                $"sport={SportFilter.Value}");
        }

        if (!string.IsNullOrWhiteSpace(Sort))
        {
            parameters.Add(
                $"sort={Uri.EscapeDataString(Sort)}");
        }

        return "/workouts?" + string.Join("&", parameters);
    }
}
