
@page "/workouts/delete"

@using Microsoft.EntityFrameworkCore
@using TrainingDiary.Models
@using TrainingDiary.Data

@inject IDbContextFactory<TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалення тренування</PageTitle>

<h1>Видалення тренування</h1>

<p>Ви впевнені, що хочете видалити це тренування?</p>

<h2>Інформація про тренування</h2>
<hr />

@if (workout is null)
{
    <p><em>Тренування не знайдено.</em></p>
}
else
{
    <WorkoutCard Workout="workout"
                 Caption="Запис для видалення"
                 ShowDetails="false" />

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    <form method="post"
          @onsubmit="DeleteWorkout"
          @formname="delete-workout-lab7">

        <AntiforgeryToken />

        <input type="hidden"
               name="WorkoutId"
               value="@workout.Id" />

        <button type="submit" class="btn btn-danger">
            Видалити
        </button>

        <a href="/workouts" class="btn btn-secondary ms-2">
            Назад до списку
        </a>
    </form>
}

@code {
    private Workout? workout;
    private string? error;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm(FormName = "delete-workout-lab7")]
    private int? WorkoutId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        workout = await context.Workouts
            .AsNoTracking()
            .Include(w => w.SportCategory)
            .Include(w => w.Exercise)
            .FirstOrDefaultAsync(w => w.Id == Id);

        if (workout is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteWorkout()
    {
        error = null;

        // Перевіряємо, що надісланий ID збігається
        // із записом, відкритим для видалення.
        if (!WorkoutId.HasValue || WorkoutId.Value != Id)
        {
            error = "Некоректний ідентифікатор тренування.";
            return;
        }

        using var context = DbFactory.CreateDbContext();

        var record = await context.Workouts
            .FirstOrDefaultAsync(w => w.Id == Id);

        if (record is null)
        {
            error = "Тренування вже видалено або не знайдено.";
            return;
        }

        try
        {
            context.Workouts.Remove(record);
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            error = "Тренування вже видалено або змінено.";
            return;
        }
        catch (DbUpdateException)
        {
            error = "Не вдалося видалити тренування. Спробуйте ще раз.";
            return;
        }

        NavigationManager.NavigateTo("/workouts");
    }
}
