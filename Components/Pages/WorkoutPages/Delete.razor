
@page "/workouts/delete"

@using Microsoft.EntityFrameworkCore
@using TrainingDiary.Models
@using TrainingDiary.Data

@inject IDbContextFactory<TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалення тренування — Щоденник тренувань</PageTitle>

<h1>Видалення тренування</h1>

@if (workout is null)
{
    <div class="alert alert-warning" role="alert">
        Тренування не знайдено.
        Можливо, його вже було видалено.
    </div>

    <a href="/workouts" class="btn btn-outline-primary">
        Повернутися до тренувань
    </a>
}
else
{
    <div class="alert alert-warning" role="alert">
        <h2 class="h5">
            Ви впевнені, що хочете видалити це тренування?
        </h2>

        <p class="mb-0">
            Після видалення запис зникне зі щоденника.
            Цю дію неможливо скасувати через інтерфейс.
        </p>
    </div>

    <h2 class="h4 mt-4">Інформація про запис</h2>

    <div class="card mb-4">
        <div class="card-body">
            <WorkoutCard Workout="workout"
                         Caption="Запис для видалення"
                         ShowDetails="true" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    <form method="post"
          @onsubmit="DeleteWorkout"
          @formname="delete-workout-lab7">

        <AntiforgeryToken />

        <input type="hidden"
               name="WorkoutId"
               value="@workout.Id" />

        <div class="d-flex flex-wrap gap-2">
            <button type="submit"
                    class="btn btn-danger">
                Так, видалити тренування
            </button>

            <a href="/workouts"
               class="btn btn-outline-secondary">
                Скасувати
            </a>
        </div>
    </form>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm(FormName = "delete-workout-lab7")]
    private int? WorkoutId { get; set; }

    private Workout? workout;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        workout = await context.Workouts
            .AsNoTracking()
            .Include(w => w.SportCategory)
            .Include(w => w.Exercise)
            .FirstOrDefaultAsync(w => w.Id == Id);
    }

    private async Task DeleteWorkout()
    {
        error = null;

        if (!WorkoutId.HasValue || WorkoutId.Value != Id)
        {
            error = "Невірний ідентифікатор тренування.";
            return;
        }

        await using var context =
            await DbFactory.CreateDbContextAsync();

        var record = await context.Workouts
            .FirstOrDefaultAsync(w => w.Id == Id);

        if (record is null)
        {
            error = "Запис уже видалено або його не знайдено.";
            return;
        }

        try
        {
            context.Workouts.Remove(record);
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            error = "Запис уже було змінено або видалено.";
            return;
        }
        catch (DbUpdateException)
        {
            error = "Не вдалося видалити тренування. Спробуйте ще раз.";
            return;
        }

        NavigationManager.NavigateTo("/workouts?deleted=true");
    }
}
