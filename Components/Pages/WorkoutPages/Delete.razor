
@page "/workouts/delete"
@using Microsoft.EntityFrameworkCore
@using TrainingDiary.Models
@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Видалення тренування</h1>

<p>Ви впевнені, що хочете видалити це тренування?</p>

<div>
    <h2>Інформація про тренування</h2>
    <hr />

    @if (workout is null)
    {
        <p><em>Завантаження...</em></p>
    }
    else
    {
        <WorkoutCard Workout="workout"
                     Caption="Запис для видалення"
                     ShowDetails="false" />

        <EditForm method="post"
                  Model="workout"
                  OnValidSubmit="DeleteWorkout"
                  FormName="delete"
                  Enhance>

            <button type="submit"
                    class="btn btn-danger">
                Видалити
            </button>

            <a href="/workouts"
               class="btn btn-secondary ms-2">
                Назад до списку
            </a>

        </EditForm>
    }
</div>

@code {
    private Workout? workout;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        workout = await context.Workouts
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (workout is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteWorkout()
    {
        using var context = DbFactory.CreateDbContext();

        context.Workouts.Remove(workout!);

        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/workouts");
    }
}
