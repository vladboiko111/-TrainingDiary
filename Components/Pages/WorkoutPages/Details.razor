
@page "/workouts/details"

@using Microsoft.EntityFrameworkCore
@using TrainingDiary.Models

@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Деталі тренування</PageTitle>

<h1>Деталі тренування</h1>
<h2>Інформація про тренування</h2>
<hr />

@if (workout is null)
{
    <p><em>Завантаження або тренування не знайдено...</em></p>
}
else
{
    <WorkoutCard Workout="workout"
                 Caption="Детальна інформація"
                 ShowDetails="true" />

    <div class="mt-3">
        <a class="btn btn-primary"
           href="@($"/workouts/edit?id={workout.Id}")">
            Редагувати
        </a>

        <a class="btn btn-secondary"
           href="/workouts">
            Назад до списку
        </a>
    </div>
}

@code {
    private Workout? workout;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        workout = await context.Workouts
            .AsNoTracking()
            .Include(w => w.SportCategory)
            .Include(w => w.Exercise)
            .FirstOrDefaultAsync(w => w.Id == Id);

        if (workout is null)
        {
            NavigationManager.NotFound();
        }
    }
}
