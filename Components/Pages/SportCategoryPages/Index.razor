
@page "/sportcategories"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using TrainingDiary.Models
@using TrainingDiary.Data

@inject IDbContextFactory<TrainingDiaryContext> DbFactory

<PageTitle>Категорії спорту — Щоденник тренувань</PageTitle>

<h1>Категорії спорту</h1>

<p class="text-muted">
    Керуйте категоріями спорту, які використовуються
    під час створення тренувань.
</p>

<p>
    <a href="/sportcategories/create"
       class="btn btn-primary">
        + Додати категорію
    </a>
</p>

@if (categories.Count == 0)
{
    <div class="alert alert-info" role="status">
        <h2 class="h5">Категорій спорту поки немає</h2>

        <p>
            Створіть першу категорію, щоб використовувати
            її під час додавання тренувань.
        </p>

        <a href="/sportcategories/create"
           class="btn btn-outline-primary">
            Створити категорію
        </a>
    </div>
}
else
{
    <div class="table-responsive"
         role="region"
         aria-label="Таблиця категорій спорту"
         tabindex="0">

        <QuickGrid Class="table table-striped table-hover"
                   Items="@categories.AsQueryable()">

            <PropertyColumn Property="category => category.Name"
                            Title="Назва категорії" />

            <TemplateColumn Title="Дії" Context="category">
                <div class="d-flex flex-wrap gap-2">

                    <a href="@($"/sportcategories/edit?id={category.Id}")"
                       class="btn btn-sm btn-outline-primary">
                        Редагувати
                    </a>

                    <a href="@($"/sportcategories/details?id={category.Id}")"
                       class="btn btn-sm btn-outline-secondary">
                        Деталі
                    </a>

                    <a href="@($"/sportcategories/delete?id={category.Id}")"
                       class="btn btn-sm btn-outline-danger">
                        Видалити
                    </a>

                </div>
            </TemplateColumn>

        </QuickGrid>
    </div>
}

@code {
    private List<SportCategory> categories = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        categories = await context.SportCategories
            .AsNoTracking()
            .OrderBy(c => c.Name)
            .ToListAsync();
    }
}
