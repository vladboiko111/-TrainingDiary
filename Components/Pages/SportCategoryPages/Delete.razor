@page "/sportcategories/delete"
@using Microsoft.EntityFrameworkCore
@using TrainingDiary.Models
@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>SportCategory</h2>
    <hr />
    @if (sportcategory is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@sportcategory.Name</dd>
        </dl>
        <EditForm method="post" Model="sportcategory" OnValidSubmit="DeleteSportCategory" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(sportcategory is null)">Delete</button> |
            <a href="/sportcategories">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private SportCategory? sportcategory;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        sportcategory = await context.SportCategories.FirstOrDefaultAsync(m => m.Id == Id);

        if (sportcategory is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteSportCategory()
    {
        using var context = DbFactory.CreateDbContext();
        context.SportCategories.Remove(sportcategory!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/sportcategories");
    }
}
