
@page "/sportcategories/create"
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using TrainingDiary.Models

@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Додати категорію спорту</PageTitle>

<h1>Додати категорію спорту</h1>
<hr />

<div class="row">
    <div class="col-md-5">

        <form method="post"
              @onsubmit="SaveCategory"
              @formname="create-sport-category">

            <AntiforgeryToken />

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger" role="alert">
                    @error
                </div>
            }

            <div class="mb-3">
                <label for="name" class="form-label">
                    Назва категорії спорту:
                </label>

                <input type="text"
                       id="name"
                       name="CategoryName"
                       value="@CategoryName"
                       maxlength="60"
                       class="form-control"
                       placeholder="Наприклад: Силові тренування" />
            </div>

            <button type="submit" class="btn btn-primary">
                Зберегти категорію
            </button>

        </form>
    </div>
</div>

<div class="mt-3">
    <a href="/sportcategories">
        Назад до списку
    </a>
</div>

@code {
    [SupplyParameterFromForm(FormName = "create-sport-category")]
    private string? CategoryName { get; set; }

    private string? error;

    private async Task SaveCategory()
    {
        error = null;

        var category = new SportCategory
        {
            Name = CategoryName?.Trim() ?? string.Empty
        };

        var validationResults = new List<ValidationResult>();

        bool isValid = Validator.TryValidateObject(
            category,
            new ValidationContext(category),
            validationResults,
            validateAllProperties: true
        );

        if (!isValid)
        {
            error = validationResults.FirstOrDefault()?.ErrorMessage
                    ?? "Перевірте назву категорії.";
            return;
        }

        try
        {
            using var context = DbFactory.CreateDbContext();

            context.SportCategories.Add(category);

            await context.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            error = "Не вдалося зберегти категорію. Спробуйте ще раз.";
            return;
        }

        NavigationManager.NavigateTo("/sportcategories");
    }
}
