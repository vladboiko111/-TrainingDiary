@page "/sportcategories/edit"
@using Microsoft.EntityFrameworkCore
@using TrainingDiary.Models
@inject IDbContextFactory<TrainingDiary.Data.TrainingDiaryContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>SportCategory</h2>
<hr />
@if (SportCategory is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="SportCategory" OnValidSubmit="UpdateSportCategory" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="SportCategory.Id" value="@SportCategory.Id" />
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="SportCategory.Name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => SportCategory.Name" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/sportcategories">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private SportCategory? SportCategory { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        SportCategory ??= await context.SportCategories.FirstOrDefaultAsync(m => m.Id == Id);

        if (SportCategory is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateSportCategory()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(SportCategory!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!SportCategoryExists(SportCategory!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/sportcategories");
    }

    private bool SportCategoryExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.SportCategories.Any(e => e.Id == id);
    }
}
